+"""Incremental arguments for a single forced tool with one string parameter."""
+import json
+import re
+
+
+def configure_text_tool_stream(request, config, model, sdk_types):
+    """Enable a closed single-string schema; callers must use real SDK streaming."""
+    model = model.rsplit("/", 1)[-1].lower()
+    version = re.match(r"gemini-(\d+)(?:[.-]|$)", model)
+    if (not getattr(request, "stream", False) or not version or int(version[1]) < 3
+            or model.startswith("gemini-3.1-flash-lite") or (getattr(request, "n", None) or 1) != 1):
+        return config, None
+    tools = getattr(request, "tools", None)
+    if not isinstance(tools, list) or len(tools) != 1 or not isinstance(tools[0], dict):
+        return config, None
+    tool = tools[0]
+    function = tool.get("function")
+    if not isinstance(function, dict):
+        return config, None
+    name = function.get("name", "")
+    schema = function.get("parameters") or {}
+    if not isinstance(schema, dict):
+        return config, None
+    properties = schema.get("properties")
+    if not isinstance(properties, dict) or len(properties) != 1:
+        return config, None
+    key, parameter = next(iter(properties.items()))
+    if (not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key)
+            or not isinstance(parameter, dict) or parameter.get("type") != "string"
+            or schema.get("type") != "object" or schema.get("required") != [key]
+            or schema.get("additionalProperties") is not False):
+        return config, None
+    if (tool.get("type") != "function" or not isinstance(name, str) or not name
+            or getattr(request, "tool_choice", None) != {"type": "function", "function": {"name": name}}):
+        return config, None
+    # Older SDKs can discard response fields or reject the request option. Keep
+    # the existing buffered conversion unless both sides of the API are present.
+    fields = getattr(getattr(sdk_types, "FunctionCall", None), "model_fields", {})
+    options = getattr(getattr(sdk_types, "FunctionCallingConfig", None), "model_fields", {})
+    if not {"partial_args", "will_continue"} <= fields.keys() or "stream_function_call_arguments" not in options:
+        return config, None
+    calling = dict((config.get("tool_config") or {}).get("function_calling_config") or {})
+    if calling.get("mode") != "ANY" or calling.get("allowed_function_names") != [name]:
+        return config, None
+    calling["stream_function_call_arguments"] = True
+    updated = dict(config)
+    updated["tool_config"] = {**config["tool_config"], "function_calling_config": calling}
+    return updated, (name, key)
+
+
+class TextToolStream:
+    def __init__(self, name, key="content"):
+        self.name = name
+        self.key = key
+        self.started = self.string_started = self.string_closed = False
+        self.closed = self.full_args = self.finished = False
+        self.index = None
+
+    @staticmethod
+    def fail(reason):
+        raise ValueError("text_tool_stream_" + reason)
+
+    def consume(self, fc):
+        if self.closed or self.finished or getattr(fc, "name", None) not in (None, self.name):
+            self.fail("unexpected_call")
+        if not self.started:
+            if getattr(fc, "name", None) != self.name:
+                self.fail("missing_name")
+            self.started = True
+        result = []
+        full = getattr(fc, "args", None)
+        if full is not None:
+            if (self.string_started or self.full_args or not isinstance(full, dict)
+                    or set(full) != {self.key} or not isinstance(full[self.key], str)):
+                self.fail("invalid_args")
+            self.full_args = self.string_closed = True
+            result.append(json.dumps(full, ensure_ascii=True))
+        partial = getattr(fc, "partial_args", None)
+        if partial is not None and not isinstance(partial, list):
+            self.fail("invalid_partial_args")
+        for part in partial or []:
+            value = getattr(part, "string_value", None)
+            more = getattr(part, "will_continue", None) is True
+            if (self.full_args or self.string_closed or getattr(part, "json_path", None) != "$." + self.key
+                    or any(getattr(part, key, None) is not None for key in ("number_value", "bool_value", "null_value"))
+                    or not (isinstance(value, str) or (value is None and self.string_started and not more))):
+                self.fail("invalid_partial_args")
+            if not self.string_started:
+                result.append("{" + json.dumps(self.key) + ':"')
+                self.string_started = True
+            if value:
+                result.append(json.dumps(value, ensure_ascii=True)[1:-1])
+            if not more:
+                result.append('"')
+                self.string_closed = True
+        if getattr(fc, "will_continue", None) is not True:
+            if not self.string_closed:
+                self.fail("incomplete_args")
+            if not self.full_args:
+                result.append("}")
+            self.closed = True
+        return "".join(result)
+
+    def finish(self, reason):
+        if self.finished:
+            self.fail("duplicate_finish")
+        if reason == "STOP" and self.started and not self.closed:
+            self.fail("incomplete_args")
+        self.finished = True
+
+    def validate_end(self):
+        if not self.finished:
+            self.fail("missing_finish_reason")
