+"""Offline tests: execute the real adapter functions with a simulated SDK."""
+import ast
+import asyncio
+import contextlib
+import io
+import json
+from pathlib import Path
+import sys
+import time
+from types import ModuleType, SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+import __future__
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "app"))
+from text_tool_stream import TextToolStream, configure_text_tool_stream
+
+NAME = "deliver_text"
+SPEC = (NAME, "content")
+SDK = NS(FunctionCall=NS(model_fields={"partial_args": None, "will_continue": None}),
+         FunctionCallingConfig=NS(model_fields={"stream_function_call_arguments": None}))
+
+
+def request(**changes):
+    data = dict(model="gemini-4-argon", stream=True, n=1, messages=[], stream_options=None,
+                tools=[{"type": "function", "function": {"name": NAME, "parameters": {
+                    "type": "object", "properties": {"content": {"type": "string"}},
+                    "required": ["content"], "additionalProperties": False}}}],
+                tool_choice={"type": "function", "function": {"name": NAME}})
+    return NS(**(data | changes))
+
+
+def config():
+    return {"tool_config": {"function_calling_config": {
+        "mode": "ANY", "allowed_function_names": [NAME]}}}
+
+
+def chunk(fc=None, reason=None, text=None, sig=None):
+    parts = []
+    if fc is not None:
+        parts.append(NS(function_call=fc, thought_signature=sig))
+    if text is not None:
+        parts.append(NS(function_call=None, text=text, thought=False, thought_signature=None))
+    return NS(candidates=[NS(content=NS(parts=parts), finish_reason=reason)])
+
+
+def fragment(value, more=True):
+    return NS(partial_args=[NS(json_path="$.content", string_value=value, will_continue=more)],
+              will_continue=True)
+
+
+def decode(sse):
+    return json.loads(sse.removeprefix("data: ").strip())
+
+
+def load_adapter():
+    # Keep tests independent of credentials, server startup and SDK installation.
+    # Compile the actual production functions; only their external dependencies
+    # (SDK/network, metadata helpers and response wrapper) are simulated.
+    tree = ast.parse((ROOT / "app/api_helpers.py").read_text(encoding="utf-8"))
+    names = {"ToolCallIndexer", "convert_chunk_to_openai", "execute_gemini_call",
+             "_extract_usage", "wants_usage", "make_usage_chunk"}
+    selected = ast.Module(body=[node for node in tree.body if getattr(node, "name", None) in names],
+                          type_ignores=[])
+    scope = dict(json=json, time=time, asyncio=asyncio, types=SDK, TextToolStream=TextToolStream,
+                 configure_text_tool_stream=configure_text_tool_stream,
+                 _safety_score_enabled=lambda: False,
+                 StreamingResponse=lambda it, **kwargs: NS(body_iterator=it),
+                 get_retry_settings=lambda: (0, 0),
+                 app_config=NS(FAKE_STREAMING_ENABLED=False),
+                 app_state=NS(get_setting=lambda *args: False),
+                 mc=NS(get_profile=lambda model: {"is_image": False}),
+                 stats=NS(add_tokens=lambda *args: None),
+                 create_openai_error_response=lambda code, msg, kind: {"error": {"message": msg, "type": kind}})
+    exec(compile(selected, str(ROOT / "app/api_helpers.py"), "exec",
+                 flags=__future__.annotations.compiler_flag), scope)
+    return scope
+
+
+class AdapterTest(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        messages = ModuleType("message_processing")
+        messages.parse_gemini_response_for_reasoning_and_content = lambda c: (
+            "", "".join(getattr(p, "text", "") for p in c.content.parts))
+        messages.build_tool_call_id = lambda *args, **kwargs: "call_test"
+        messages.thought_signature_extra = lambda sig: {"google": {"thought_signature": sig}} if sig else None
+        messages.ordinary_part_metadata = lambda kind, text, sig: {"kind": kind, "text": text}
+        messages._convert_image_to_markdown = lambda *args: ""
+        messages._signature_bytes = lambda part, fc: getattr(part, "thought_signature", None)
+        signatures = ModuleType("signature_store")
+        signatures.SignatureState = NS(UNSIGNED_FOLLOWER="follower", UNKNOWN="unknown")
+        self.modules = patch.dict(sys.modules, message_processing=messages, signature_store=signatures)
+        self.modules.start()
+        self.addCleanup(self.modules.stop)
+        self.adapter = load_adapter()
+        self.calls = []
+        output = contextlib.redirect_stdout(io.StringIO())
+        output.__enter__()
+        self.addCleanup(output.__exit__, None, None, None)
+
+    def test_eligible_request_and_sdk_gate(self):
+        original = config()
+        enabled, name = configure_text_tool_stream(request(), original,
+            "projects/example/locations/global/publishers/google/models/gemini-4-argon", SDK)
+        self.assertEqual(name, SPEC)
+        self.assertTrue(enabled["tool_config"]["function_calling_config"]["stream_function_call_arguments"])
+        self.assertEqual(original, config())
+        for model in ("gemini-2.5-pro", "gemini-3.1-flash-lite", "other-model"):
+            self.assertIsNone(configure_text_tool_stream(request(), original, model, SDK)[1])
+        wrong_schema = request()
+        wrong_schema.tools[0]["function"]["parameters"]["properties"]["other"] = {"type": "string"}
+        for req in (request(stream=False), request(n=2), request(tool_choice="auto"),
+                    request(tools=[]), request(tools=request().tools * 2), wrong_schema):
+            self.assertIsNone(configure_text_tool_stream(req, original, req.model, SDK)[1])
+        self.assertIsNone(configure_text_tool_stream(request(), original, "gemini-4-argon", NS())[1])
+
+    def test_single_string_parameter_is_not_coupled_to_tool_or_argument_name(self):
+        req = request()
+        schema = req.tools[0]["function"]["parameters"]
+        schema["properties"] = {"message": {"type": "string", "description": "Text to deliver"}}
+        schema["required"] = ["message"]
+        enabled, spec = configure_text_tool_stream(req, config(), req.model, SDK)
+        self.assertEqual(spec, (NAME, "message"))
+        parser = TextToolStream(*spec)
+        result = parser.consume(NS(name=NAME, partial_args=[
+            NS(json_path="$.message", string_value="hello", will_continue=True)], will_continue=True))
+        result += parser.consume(NS(partial_args=[NS(json_path="$.message")]))
+        self.assertEqual(json.loads(result), {"message": "hello"})
+        parser.finish("STOP")
+        parser.validate_end()
+
+    def test_fragments_use_one_identity_and_preserve_signatures(self):
+        indexer = self.adapter["ToolCallIndexer"](SPEC)
+        fragments = ['中文 "quoted"\\path\n', "\ud83d", "\ude00"]
+        chunks = [chunk(NS(name=NAME, will_continue=True))]
+        chunks += [chunk(fragment(value)) for value in fragments]
+        chunks += [chunk(NS(partial_args=[NS(json_path="$.content")], will_continue=True), sig="late-signature"),
+                   chunk(NS()), chunk(reason="STOP")]
+        records = [decode(self.adapter["convert_chunk_to_openai"](item, "test", "id", indexer=indexer))
+                   for item in chunks]
+        deltas = [tc for record in records for tc in record["choices"][0]["delta"].get("tool_calls", [])]
+        self.assertEqual([tc["index"] for tc in deltas], [0] * len(deltas))
+        self.assertEqual(sum("id" in tc for tc in deltas), 1)
+        self.assertEqual(sum("name" in tc["function"] for tc in deltas), 1)
+        arguments = "".join(tc["function"]["arguments"] for tc in deltas)
+        self.assertEqual(json.loads(arguments)["content"], '中文 "quoted"\\path\n😀')
+        self.assertEqual(deltas[-2]["extra_content"]["google"]["thought_signature"], "late-signature")
+        self.assertEqual(records[-1]["choices"][0]["finish_reason"], "tool_calls")
+        self.assertEqual(records[-1]["choices"][0]["delta"]["extra_content"]["google"]["part_order"],
+                         [{"type": "tool_call", "index": 0}])
+        indexer.text_stream.validate_end()
+        with self.assertRaisesRegex(ValueError, "data_after_finish"):
+            self.adapter["convert_chunk_to_openai"](chunk(text="late"), "test", "id", indexer=indexer)
+
+    def test_full_arguments_plain_text_and_regular_multiple_tools(self):
+        indexer = self.adapter["ToolCallIndexer"](SPEC)
+        record = decode(self.adapter["convert_chunk_to_openai"](
+            chunk(NS(name=NAME, args={"content": "complete"}), "STOP"), "test", "id", indexer=indexer))
+        self.assertEqual(json.loads(record["choices"][0]["delta"]["tool_calls"][0]["function"]["arguments"]),
+                         {"content": "complete"})
+        indexer = self.adapter["ToolCallIndexer"](SPEC)
+        record = decode(self.adapter["convert_chunk_to_openai"](chunk(reason="STOP", text="plain"),
+            "test", "id", indexer=indexer))
+        self.assertEqual(record["choices"][0]["delta"]["content"], "plain")
+        indexer = self.adapter["ToolCallIndexer"]()
+        for i in range(2):
+            record = decode(self.adapter["convert_chunk_to_openai"](
+                chunk(NS(name="regular", args={"n": i})), "test", "id", indexer=indexer))
+            self.assertEqual(record["choices"][0]["delta"]["tool_calls"][0]["index"], i)
+
+    def test_rejects_invalid_fragments_and_false_success(self):
+        for part in (NS(json_path="$.other", string_value="x"), NS(json_path="$.content", number_value=0),
+                     NS(json_path="$.content", bool_value=False), NS(json_path="$.content", will_continue=True)):
+            parser = TextToolStream(NAME)
+            parser.consume(NS(name=NAME, will_continue=True))
+            parser.consume(fragment("prefix"))
+            with self.assertRaisesRegex(ValueError, "invalid_partial_args"):
+                parser.consume(NS(partial_args=[part]))
+        parser = TextToolStream(NAME)
+        parser.consume(NS(name=NAME, will_continue=True))
+        with self.assertRaisesRegex(ValueError, "invalid_partial_args"):
+            parser.consume(NS(partial_args=[NS(json_path="$.content")]))
+        parser.consume(fragment("incomplete"))
+        with self.assertRaisesRegex(ValueError, "incomplete_args"):
+            parser.finish("STOP")
+        with self.assertRaisesRegex(ValueError, "missing_finish_reason"):
+            parser.validate_end()
+        parser.finish("MAX_TOKENS")
+        parser.validate_end()
+        with self.assertRaisesRegex(ValueError, "unexpected_call"):
+            parser.consume(fragment("late"))
+
+    async def run_stream(self, stream):
+        async def generate(**kwargs):
+            self.calls.append(kwargs)
+            return stream
+        client = NS(aio=NS(models=NS(generate_content_stream=generate)))
+        result = await self.adapter["execute_gemini_call"](
+            client, "gemini-4-argon", lambda messages: [], config(), request())
+        return result.body_iterator
+
+    async def test_real_generator_delivers_before_upstream_finishes(self):
+        release = asyncio.Event()
+        async def upstream():
+            yield chunk(NS(name=NAME, will_continue=True))
+            yield chunk(fragment("early text"))
+            await release.wait()
+            yield chunk(NS(partial_args=[NS(json_path="$.content")]))
+            yield chunk(reason="STOP")
+        stream = await self.run_stream(upstream())
+        first = []
+        while True:
+            value = await asyncio.wait_for(anext(stream), 1)
+            first.append(value)
+            if "early text" in value:
+                break
+        self.assertFalse(release.is_set())
+        self.assertTrue(self.calls[0]["config"]["tool_config"]["function_calling_config"]["stream_function_call_arguments"])
+        release.set()
+        tail = [item async for item in stream]
+        self.assertIn('"finish_reason": "tool_calls"', "".join(tail))
+        self.assertEqual(tail[-1], "data: [DONE]\n\n")
+
+    async def test_interruption_remains_error_after_content_without_retry(self):
+        for failure in ("eof", "exception", "stop"):
+            self.calls.clear()
+            async def upstream():
+                yield chunk(NS(name=NAME, will_continue=True))
+                yield chunk(fragment("partial"))
+                if failure == "exception":
+                    raise RuntimeError("upstream interrupted")
+                if failure == "stop":
+                    yield chunk(reason="STOP")
+            stream = await self.run_stream(upstream())
+            wire = "".join([item async for item in stream])
+            self.assertIn('"error":', wire)
+            self.assertNotIn('"finish_reason": "stop"', wire)
+            self.assertNotIn('"finish_reason": "tool_calls"', wire)
+            self.assertEqual(len(self.calls), 1)
+
+    async def test_safety_and_length_stay_non_success(self):
+        for reason, expected in (("MAX_TOKENS", "length"), ("SAFETY", "content_filter")):
+            async def upstream():
+                yield chunk(NS(name=NAME, will_continue=True))
+                yield chunk(fragment("partial"))
+                yield chunk(reason=reason)
+            wire = "".join([item async for item in await self.run_stream(upstream())])
+            self.assertIn(f'"finish_reason": "{expected}"', wire)
+            self.assertNotIn('"error":', wire)
+
+
+if __name__ == "__main__":
