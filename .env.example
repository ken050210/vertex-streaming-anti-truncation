# Variables already set in the system or shell environment take precedence over this file.

# Generate your own random gateway key: at least 16 visible ASCII characters, no spaces.
GATEWAY_API_KEY=
VERTEX_PROJECT_ID=your-project-id
VERTEX_LOCATION=global
PORT=4781
UPSTREAM_TIMEOUT_MS=600000

# Optional account pool. The existing connection remains the primary account.
# Additional accounts: JSON array with id, name, authMode, credential and
# projectId/location (Vertex) or customBaseUrl (OpenAI-compatible upstream).
ACCOUNT_ROTATION_ENABLED=false
ACCOUNT_TIMEOUT_MS=60000
ACCOUNT_FAILURE_THRESHOLD=2
ACCOUNT_COOLDOWN_MS=60000
# GATEWAY_ACCOUNTS_FILE=/absolute/private/accounts.json
GUI_PORT=4780
# Native installs stay local by default. Docker sets LISTEN_HOST=0.0.0.0.
# LISTEN_HOST=127.0.0.1
# For a mapped console port or reverse proxy, set its exact browser-facing origin.
# GUI_ORIGIN=https://console.example.com
# Optional client-facing API URL displayed in the console (does not change routing).
# GATEWAY_PUBLIC_URL=https://gateway.example.com/v1
VERTEX_SERVICE_TIER=standard
ANTI_TRUNCATION=true
HIDE_UNAVAILABLE_MODELS=true
GEMINI_PREFILL_TO_USER=true
# Gemini 4 Argon long decode: continue replies past one request's output limit. Adds requests and cost; see docs/GEMINI4.en.md.
GEMINI_LONG_DECODE=false
GEMINI_PROMPT_RETRY_ENABLED=false
# Optional UTF-8 file outside the repository (around 7000 tokens of your own text).
# Required when enabling the one-time prompt submission retry.
# GEMINI_PROMPT_RETRY_TEXT_FILE=C:/path/to/retry-context.txt
# Optional: upstream error texts that trigger the one-time retry, separated by "|".
# Defaults to: The prompt could not be submitted
# GEMINI_PROMPT_RETRY_MATCHES=The prompt could not be submitted|PROHIBITED_CONTENT
# Optional: external directory for GUI settings. Defaults to your home directory.
# GATEWAY_STATE_DIR=D:/vertex-gateway-state

# Service account: remove the leading "#" and point to a JSON file kept OUTSIDE the
# cloned repository. Forward slashes work on Windows.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Alternative: omit GOOGLE_APPLICATION_CREDENTIALS and supply a short-lived
# Google OAuth access token. Do not configure both authentication methods.
# VERTEX_ACCESS_TOKEN=

# Express mode alternative: omit both credentials above.
# Set VERTEX_PROJECT_ID to the key's project ID/number for explicit global routing (required for Argon).
# Without a project, other models keep the projectless Express endpoint.
# VERTEX_API_KEY=
# Flex/Priority/Express require VERTEX_LOCATION=global.

# Custom upstream alternative: an OpenAI-compatible service that serves Gemini models.
# Omit the Google credentials above; project, location and service tier are not used.
# Requests go to <CUSTOM_UPSTREAM_URL>/chat/completions with a Bearer key.
# CUSTOM_UPSTREAM_URL=https://relay.example.com/v1
# CUSTOM_UPSTREAM_API_KEY=

# Global input encoding for all models; requires router_unicode_input.user_floor.
UNICODE_INPUT=false

# off | current-turn | all; mutually exclusive with UNICODE_INPUT
IMAGE_INPUT=off
